{
  "name": "trailline",
  "version": "0.0.1",
  "description": "A provenance layer for AI-generated reports — every number, chart, and claim traces back to the query that produced it.",
  "type": "module",
  "main": "index.js",
  "bin": {
    "trailline": "index.js"
  },
  "files": [
    "index.js"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "node index.js"
  },
  "keywords": [
    "trailline",
    "provenance",
    "lineage",
    "data-lineage",
    "sql",
    "reporting",
    "analytics",
    "ai"
  ],
  "author": "Varun Jain <varunjainvj1@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trailline/trailline.git"
  },
  "bugs": {
    "url": "https://github.com/trailline/trailline/issues"
  },
  "homepage": "https://github.com/trailline/trailline#readme",
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2"
  }
}
